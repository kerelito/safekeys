MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/locker-system?retryWrites=true&w=majority
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-secret
DEVICE_API_KEY=change-me-device-secret
DEVICE_ID=esp32-main
DEVICE_WS_PATH=/device/ws
DEVICE_HEARTBEAT_TIMEOUT_MS=180000
DEVICE_COMMAND_REDELIVER_AFTER_MS=30000
DEVICE_COMMAND_DELIVERY_LIMIT=20
DEVICE_WS_PING_INTERVAL_MS=30000
DEVICE_WS_PING_GRACE_MS=15000
DEVICE_WS_HELLO_TIMEOUT_MS=10000
DEVICE_WS_SERVER_HELLO_DELAY_MS=50
RETURN_SESSION_TIMEOUT_MS=120000
ENABLE_DOOR_SENSORS=false
# Seed startowy do bazy użytkowników panelu.
# Zostanie użyty tylko wtedy, gdy kolekcja użytkowników panelu jest pusta.
ADMIN_1_USERNAME=admin
ADMIN_1_PASSWORD=change-me-1
ADMIN_1_DISPLAY_NAME=Jan Kowalski
ADMIN_2_USERNAME=operator
ADMIN_2_PASSWORD=change-me-2
ADMIN_2_DISPLAY_NAME=Anna Nowak
ADMIN_3_USERNAME=manager
ADMIN_3_PASSWORD=change-me-3
ADMIN_3_DISPLAY_NAME=Piotr Zielinski
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_NOTIFICATIONS_CHANNEL_ID=
# Brevo API (recommended on Railway Free/Trial/Hobby)
BREVO_API_KEY=xkeysib-twoj-klucz-api-brevo
SMTP_FROM_EMAIL=powiadomienia@safekeys.pl
SMTP_FROM_NAME=SafeKeys
SMTP_REPLY_TO=kontakt@safekeys.pl

# Optional SMTP fallback for environments that allow outbound SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=twoj-login-brevo@example.com
SMTP_PASS=twoj-klucz-smtp-brevo
